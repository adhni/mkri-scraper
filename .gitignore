.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/

tests/fixtures/pdfs/*.pdf
!tests/fixtures/pdfs/.gitkeep
!tests/fixtures/pdfs/README.md

tests/manual_truth/*.json
!tests/manual_truth/.gitkeep
!tests/manual_truth/README.md

!data/parsed_json/.gitkeep

!data/validated_json/.gitkeep

!data/review_queue/.gitkeep

data/raw_pdfs/*.pdf
data/raw_pdfs/**/*.pdf
!data/raw_pdfs/.gitkeep

data/inbox_pdfs/*.pdf
!data/inbox_pdfs/.gitkeep

data/pipeline_state/*.json
!data/pipeline_state/.gitkeep

data/pipeline_reports/*.json
data/discovery/**/*.json
data/discovery/**/*.html

# Local upload library, PDFs, drafts, and owner corrections
data/library/
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
